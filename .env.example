# Copy this file to .env.local and fill in your key.
# .env.local is gitignored — never commit your real key.

OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_MODEL=gpt-4o-mini

# ── RAG (retrieval-augmented answers) ────────────────────────────────────
# The chat route calls a local Python sidecar (scripts/rag/rag_server.py) to
# pull grounding passages. Start it with `npm run dev:rag`.
RAG_SERVER_URL=http://127.0.0.1:8000
EMBEDDING_MODEL=text-embedding-3-large
RAG_TOP_K=6
# RAG_ENABLED=false          # set to disable retrieval entirely
# RAG_TIMEOUT_MS=8000        # abort the sidecar call and answer ungrounded
# RAG_MAX_CHUNK_CHARS=1600   # per-passage truncation
# RAG_MAX_CONTEXT_CHARS=12000
